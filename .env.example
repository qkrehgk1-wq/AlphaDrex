# 실제 키는 env.local(또는 .env.local)에 저장합니다. 공개 저장소에 올리지 마세요.
# 서버는 시작할 때 env.local → .env.local → .env 순서로 읽고, 아래 이름만 인정합니다.
# Windows PowerShell 예: $env:LINER_API_KEY='발급받은 키'; python -m app.server
LINER_API_KEY=
LINER_MODEL=liner-gpt-router
DREX_URL=http://127.0.0.1:8000/v1/systemone
DREX_MODEL=drex-v1.5
ALPHADREX_PORT=8765
ALPHADREX_INTERNAL_ONLY=0
ALPHADREX_BRAIN=hybrid
ALPHADREX_DREX_BUDGET_S=60
ALPHADREX_SHADOW_RATE=0.1
# 한 번의 요청이 AI 응답을 기다리는 전체 상한(초). 넘으면 로컬 규칙 결과로 답하고 담당자 검토로 표시합니다.
ALPHADREX_MAX_WAIT_S=120
# python -m tools.setup_agents 로 로컬 에이전트 인증 설정을 생성합니다.
# ALPHADREX_AGENT_TOKENS={"facilities":{"token":"32자_이상_무작위_토큰","mode":"internal"}}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 선택: 부서별 등록 대상. chat_id는 관리자만 설정하며 토큰은 별도 보관합니다.
# ALPHADREX_TELEGRAM_TARGETS={"operations":{"label":"운영팀","chat_id":"-123456"}}
